  create view "postgres"."public_staging"."stg_nasa_power__dbt_tmp"
    
    
  as (
    select
    city,
    country,
    lat,
    lon,
    year,
    month,
    t2m                                           as temp_c,
    -- NASA devuelve mm/día, convertimos a mm/mes
