ct\n    city,\n    country,\n    year,\n    month,\n    temp_c,\n    precip_mm,\n    sst_anomaly,\n    enso_phase\nfrom joined", "relation_name": "\"postgres\".\"public_marts\".\"mart_climate_by_enso\"", "batch_results": null, "overload_results": null}], "elapsed_time": 15.732003927230835, "args": {"exclude": [], "require_source_and_semantic_model_names_without_spaces": false, "use_catalogs_v2": false, "support_custom_ref_kwargs": false, "require_explicit_package_overrides_for_builtin_materializations": true, "allow_jinja_file_extensions": false, "use_colors": true, "require_yaml_configuration_for_mf_time_spines": true, "state_modified_compare_vars": false, "require_all_warnings_handled_by_warn_error": true, "favor_state": false, "print": true, "require_batched_execution_for_custom_microbatch_strategy": true, "log_level": "info", "log_format_file": "debug", "state_modified_compare_more_unrendered_values": true, "skip_nodes_if_on_run_start_fails": true, "quiet": false, "warn_error_options": {"error": [], "warn": [], "silence": []}, "project_dir": "C:\\Users\\Gonza\\Desktop\\repos\\el_nino_impact\\dbt", "use_v2_parser": false, "require_nested_cumulative_type_params": true, "log_file_max_bytes": 10485760, "log_path": "C:\\Users\\Gonza\\Desktop\\repos\\el_nino_impact\\dbt\\logs", "enable_grouped_warn_error_parser_logs": false, "vars": {}, "write_json": true, "require_ref_searches_node_package_before_root": false, "cache_selected_only": false, "log_format": "default", "v2_parser": "dbt-core-experimental-parser parse", "invocation_command": "dbt run", "require_valid_schema_from_generate_schema_name": false, "version_check": true, "profiles_dir": "C:\\Users\\Gonza\\Desktop\\repos\\el_nino_impact\\dbt", "empty": false, "require_resource_names_without_spaces": true, "macro_debugging": false, "partial_parse_file_diff": true, "latest_version_pointer_enabled_by_default": false, "send_anonymous_usage_stats": true, "upload_to_artifacts_ingest_api": false, "introspect": true, "sho